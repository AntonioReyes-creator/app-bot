APP_NAME="App Bot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Solo desarrollo: entrar al editor sin pasar por el sistema principal.
# Se ignora si APP_ENV no es local. En producción: false.
ACCESO_LOCAL=false

# Clave que usa el proyecto existente para llamar a /api/* (Authorization: Bearer ...).
# Generar: php -r "echo bin2hex(random_bytes(32));" · la misma en ambos proyectos. Vacía = API cerrada.
API_KEY=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local: MariaDB 10.4 de XAMPP, base app_bot (verla en HeidiSQL).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_bot
DB_USERNAME=root
DB_PASSWORD=

# Sesiones, caché y colas se guardan en tablas de la base de datos.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
